<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Package visibility: since API 30 an app cannot even see that a camera exists without
      declaring the intent it wants to resolve. Without this, `resolveActivity` returns null
      on a device that has a perfectly good camera app and the sample disables its own
      button. Note this is NOT a permission: launching another app's camera activity needs
      none, and declaring `android.permission.CAMERA` would actively make things worse: it
      makes the permission required at install time for a capability this app never uses
      directly.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".source.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".OpenPdf"
            android:targetActivity=".source.activity.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity-alias>

        <!--
          Somewhere for the camera app to write the photo. `TakePicture` needs a destination
          URI that another process may write to, and a `file://` URI has been a
          `FileUriExposedException` since Nougat.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
